// Random numbers and blue noise, a module of its own that pathtracer imports. The blue-noise tensor is generated by
// this module's own compute shaders, noiseStart then noiseSweep, run once where no tensor is stored; rendering only
// reads it, through the consumer's binding
module noise;

public static const uint UINT_MAX = 4294967295u;

// Blue noise: a fixed S x S x NOISE_LAYERS tensor of texels of two 16-bit ranks, toroidal in all three dimensions,
// texel (x, y) of layer t at (t * S + y) * S + x, its ranks as channel 0 | channel 1 << 16
// Layers of the tensor
public static const uint NOISE_LAYERS = 32u;
// The consumer's texel where no tensor is bound
public static const uint NOISE_UNBOUND = 0xFFFFFFFFu;

__extern_cpp public struct Random {
    __extern_cpp public uint state;
    __extern_cpp public float value;
};

[CudaDeviceExport] public Random pcg(uint state) {
    __target_switch {
    case wgsl:
    case glsl:
    // PCG random number generator
    return Random(state * 747796405u + 2891336453u, float(hash(state)) / float(UINT_MAX));
    default:
        const float value = ((state = hash(state)) >> 8) * 0x1p-24f;
        return Random(state, value);
    }
}

[CudaDeviceExport] public func hash(x: uint) -> uint {
    let state: uint = x * 747796405u + 2891336453u;
    let word: uint = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

[CudaDeviceExport] public func stream(seed: uint, index: uint) -> uint {
    return hash(seed ^ hash(index));
}

// The start: texel (x, y) of layer t takes its index's place in a permutation of the layer's S^2 texels per channel c,
// a Feistel network of four rounds over (x, y) keyed by t and c, scaled to 16 bits, so every channel of every layer is
// exactly uniform; S a power of two. A texel whose ranks both came out 65535, which reads as NOISE_UNBOUND, trades its
// channel 1 with the texel S / 2 across, which keeps every channel a permutation
[CudaDeviceExport] public func noiseWhite(x: uint, y: uint, t: uint, size: uint) -> uint {
    // Channels 0 and 1 of (x, y), then of the texel across
    var ranks: uint[4];
    for (var i: uint = 0u; i < 4u; i++) {
        var l: uint = i < 2u ? x : (x + size / 2u) & (size - 1u);
        var r: uint = y;
        for (var k: uint = 0u; k < 4u; k++) {
            let next: uint = l ^ (hash(r ^ t << 16u ^ k << 28u ^ (i & 1u) << 31u) & (size - 1u));
            l = r;
            r = next;
        }
        let index: uint = l + r * size;
        ranks[i] = size * size >= 65536u ? index / (size * size / 65536u) : index * (65536u / (size * size));
    }
    let unbound: bool = ranks[0] == 0xFFFFu && ranks[1] == 0xFFFFu;
    let across_unbound: bool = ranks[2] == 0xFFFFu && ranks[3] == 0xFFFFu;
    let trade: bool = (unbound && ranks[3] != 0xFFFFu) || (across_unbound && ranks[1] != 0xFFFFu);
    return ranks[0] | (trade ? ranks[3] : ranks[1]) << 16u;
}

// The start's pass, one thread per texel
[shader("compute")] [numthreads(64, 1, 1)]
void noiseStart(uint3 id: SV_DispatchThreadID, uniform RWStructuredBuffer<uint> tensor, uniform uint size) {
    if (id.x < size * size * NOISE_LAYERS) {
        tensor[id.x] = noiseWhite(id.x % size, id.x / size % size, id.x / (size * size), size);
    }
}
